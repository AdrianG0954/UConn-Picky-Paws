# Target for Vite dev proxy (/api -> backend). Default: http://127.0.0.1:8000
# In Docker Compose the frontend service sets: PROXY_TARGET=http://backend:8000
PROXY_TARGET=http://127.0.0.1:8000

# Set to 1 when running Vite inside Docker so file watching uses polling (optional for local npm run dev)
# DOCKER_DEV=1
